# Container image for the Tokenomics FastAPI service, built from the repository
# root so the deployment config can be baked in. Build:
#   az acr build -r <acr> -t fabric-tokenomics-api:latest -f api/Dockerfile.deploy .
FROM python:3.12-slim

# Microsoft ODBC Driver 18 for SQL Server (required by pyodbc for the Fabric
# SQL analytics endpoint).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg apt-transport-https \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -sSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Application code and the config it reads (config-driven, no hard-coded values).
COPY api/app ./api/app
COPY config/deployment.json ./config/deployment.json
COPY config/tokenomics-prompts.json ./config/tokenomics-prompts.json

# The config loader resolves paths three levels up from api/app/config.py,
# i.e. the /srv working directory — matching the layout copied above.
ENV PORT=8080
EXPOSE 8080

# Run from /srv so `api.app` resolves and config paths resolve to /srv/config.
CMD ["sh", "-c", "cd /srv/api && uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
