      "key": [
        "model_family"
      ],
      "properties": [
        "model_family"
      ],
      "synonyms": [
        "family",
        "model series",
        "model line"
      ],
      "propertyMeta": {
        "model_family": {
          "description": "Family the model belongs to (e.g. GPT-5, Claude Opus).",
          "synonyms": [
            "family"
          ]
        }
      }
    },
    {
      "id": "Model",
      "label": "Model",
