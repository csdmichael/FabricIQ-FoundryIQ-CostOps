      "key": [
        "model_name",
        "model_version"
      ],
      "properties": [
        "model_name",
        "model_version"
      ],
      "synonyms": [
        "LLM",
        "language model",
        "AI model",
        "deployment"
      ],
      "propertyMeta": {
        "model_name": {
          "description": "Specific model name.",
          "synonyms": [
            "model"
          ]
        },
        "model_version": {
          "description": "Model version identifier.",
          "synonyms": [
            "version"
          ]
        }
      }
    },
    {
      "id": "PricePoint",
      "label": "Price Point",
      "category": "pricing",
      "description": "An effective-dated token price (market and negotiated, input/output/cached per million tokens) for a model. Slowly-changing (SCD-2) - the source of truth for costing.",
      "source": "prices.token_price_history",
      "key": [
        "price_id"
      ],
      "properties": [
        "effective_from",
        "effective_to",
        "is_current",
        "market_input_usd_per_million",
        "market_output_usd_per_million",
        "negotiated_input_usd_per_million",
        "negotiated_output_usd_per_million",
        "source_name"
      ],
      "synonyms": [
        "price",
        "rate",
        "rate card",
        "token price",
        "tariff",
        "unit price"
      ],
      "propertyMeta": {
        "effective_from": {
          "description": "Timestamp when this price became effective (SCD-2 start).",
          "synonyms": [
            "valid from",
            "start date"
          ]
        },
        "effective_to": {
          "description": "Timestamp when this price stopped being effective (SCD-2 end; null if current).",
          "synonyms": [
            "valid to",
            "end date"
          ]
        },
        "is_current": {
          "description": "Whether this is the currently effective price row.",
          "synonyms": [
            "current",
            "latest"
          ]
        },
        "market_input_usd_per_million": {
          "description": "Public list price per million input tokens (USD).",
          "synonyms": [
            "list input price",
            "market input rate"
          ]
        },
        "market_output_usd_per_million": {
          "description": "Public list price per million output tokens (USD).",
          "synonyms": [
            "list output price",
            "market output rate"
          ]
        },
        "negotiated_input_usd_per_million": {
          "description": "Enterprise-negotiated price per million input tokens (USD).",
          "synonyms": [
            "negotiated input rate",
            "discounted input price"
          ]
        },
        "negotiated_output_usd_per_million": {
          "description": "Enterprise-negotiated price per million output tokens (USD).",
          "synonyms": [
            "negotiated output rate",
            "discounted output price"
          ]
        },
        "source_name": {
          "description": "Name of the pricing source that published this rate.",
          "synonyms": [
            "price source"
          ]
        }
      }
    },
    {
      "id": "AICreditPricePoint",
      "label": "AI Credit Price Point",
      "category": "pricing",
      "description": "An effective-dated Microsoft Copilot Studio AI credit price: list and negotiated USD per AI credit plus the prepaid pack effective rate. Converts AI credits to dollars because Copilot Studio usage has no token telemetry.",
      "source": "prices.ai_credit_price_history",
      "key": [
        "price_id"
      ],
      "properties": [
        "effective_from",
        "effective_to",
        "is_current",
        "market_usd_per_credit",
        "negotiated_usd_per_credit",
        "prepaid_pack_credits",
        "prepaid_pack_price_usd",
        "prepaid_effective_usd_per_credit",
        "source_name"
      ],
      "synonyms": [
        "AI credit price",
        "copilot credit rate",
        "copilot studio rate",
        "credit rate card",
        "credit price"
      ],
      "propertyMeta": {
        "market_usd_per_credit": {
          "description": "List (pay-as-you-go) USD per AI credit.",
          "synonyms": [
            "list credit rate",
            "pay as you go credit price"
          ]
        },
        "negotiated_usd_per_credit": {
          "description": "Negotiated USD per AI credit after the enterprise discount.",
          "synonyms": [
            "negotiated credit rate"
          ]
        },
        "prepaid_effective_usd_per_credit": {
          "description": "Effective USD per AI credit for the prepaid pack (pack price divided by pack credits).",
          "synonyms": [
            "pack credit rate"
          ]
        }
      }
    },
    {
      "id": "UsageEvent",
      "label": "AI Consumption Event",
      "category": "fact",
      "description": "The Gold fact: governed AI consumption. Azure AI Foundry and multi-cloud rows carry token usage (input/output/cached tokens, latency). Microsoft Copilot Studio rows carry AI credits and no tokens. Market, negotiated, and actual USD cost are attributed to the full org hierarchy.",
      "source": "ml.tokenomics_usage_fact",
      "key": [
        "event_id"
      ],
      "properties": [
        "event_ts",
        "usage_date",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "market_cost_usd",
        "negotiated_cost_usd",
        "actual_cost_usd",
        "quality_score",
        "consumption_unit",
        "service_code",
        "ai_credits",
        "credit_unit_price_usd"
      ],
      "synonyms": [
        "usage",
        "consumption",
        "token usage",
        "request",
        "call",
        "invocation",
        "telemetry"
      ],
      "propertyMeta": {
        "consumption_unit": {
          "description": "tokens for token-billed rows; ai_credits for Microsoft Copilot Studio rows.",
          "synonyms": [
            "billing unit",
            "meter"
          ]
        },
        "service_code": {
          "description": "Microsoft product: azure-ai-foundry or copilot-studio (null for other providers).",
          "synonyms": [
            "service",
            "product"
          ]
        },
        "ai_credits": {
          "description": "AI credits consumed (Copilot Studio); zero for token rows.",
          "synonyms": [
            "copilot credits",
            "credits"
          ]
        },
        "credit_unit_price_usd": {
          "description": "List USD per AI credit applied to the row; zero for token rows.",
          "synonyms": [
            "credit price"
          ]
        },
        "event_ts": {
          "description": "Timestamp of the usage event.",
          "synonyms": [
            "timestamp",
            "event time"
          ]
        },
        "usage_date": {
          "description": "Calendar date of the usage event.",
          "synonyms": [
            "date",
            "day"
          ]
        },
        "input_tokens": {
          "description": "Number of input (prompt) tokens consumed.",
          "synonyms": [
            "prompt tokens"
          ]
        },
        "output_tokens": {
          "description": "Number of output (completion) tokens produced.",
          "synonyms": [
            "completion tokens"
          ]
        },
        "total_tokens": {
          "description": "Total tokens consumed (input + output).",
          "synonyms": [
            "tokens"
          ]
        },
        "market_cost_usd": {
          "description": "Cost at public list price (USD).",
          "synonyms": [
            "list cost",
            "market cost"
          ]
        },
        "negotiated_cost_usd": {
          "description": "Cost at enterprise-negotiated price (USD).",
          "synonyms": [
            "negotiated cost",
            "discounted cost"
          ]
        },
        "actual_cost_usd": {
          "description": "Azure-billed cost allocated by observed token share (USD).",
          "synonyms": [
            "billed cost",
            "actual cost"
          ]
        },
        "quality_score": {
          "description": "Quality score of the outcome (0-1).",
          "synonyms": [
            "quality"
          ]
        }
      }
    },
