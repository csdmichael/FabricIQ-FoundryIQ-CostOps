{
  "ontology": "Multi-Cloud AI Tokenomics & FinOps",
  "version": "1.0.0",
  "description": "Business ontology (semantic layer) over the governed Fabric Lakehouse. Maps FinOps business concepts to physical Lakehouse tables and defines the relationships that connect pricing, token usage, organization, governance, and the 12 ML outputs so questions can be answered against meaning rather than raw tables.",
  "schemas": {
    "sources": [
      "aws",
      "gcp",
      "msft",
      "oai",
      "cld"
    ],
    "gold": "ml",
    "pricing": "prices"
  },
  "classes": [
    {
      "id": "Provider",
      "label": "Cloud / Model Provider",
      "category": "dimension",
      "description": "A cloud or model provider that serves AI models (AWS Bedrock, GCP Vertex AI, Azure AI Foundry, OpenAI Direct, Anthropic Claude, and Microsoft Copilot Studio, which is msft with service_code copilot-studio).",
      "source": "ml.tokenomics_usage_fact",
      "key": [
        "source_code"
      ],
      "properties": [
        "source_code",
        "providerName"
      ],
      "synonyms": [
        "cloud",
        "vendor",
        "model provider",
        "cloud provider",
        "platform"
      ],
      "propertyMeta": {
        "source_code": {
          "description": "Provider code (aws, gcp, msft, oai, cld). msft covers Azure AI Foundry and Microsoft Copilot Studio; use service_code to separate them.",
          "synonyms": [
            "provider code",
            "cloud code"
          ]
        },
        "providerName": {
          "description": "Human-readable provider name.",
          "synonyms": [
            "provider name"
          ]
        }
      }
    },
    {
      "id": "ModelFamily",
      "label": "Model Family",
      "category": "dimension",
      "description": "A family of related models (e.g. GPT-5, Claude Opus, Gemini 2.5).",
