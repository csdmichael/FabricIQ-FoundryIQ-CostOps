{
  "openapi": "3.0.1",
  "info": {
    "title": "Fabric Tokenomics API",
    "version": "2.0.0",
    "description": "Returns privacy-preserving APIM usage, token telemetry, rate-card estimates, and Azure Cost Management ActualCost reconciliation."
  },
  "paths": {
    "/summary": {
      "get": {
        "operationId": "summary",
        "summary": "Get the tokenomics dashboard summary",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [1, 7, 30, 90],
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tokenomics dashboard data with distinct estimated and billed cost fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenomicsDashboard"
                }
              }
            }
          }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    },
    "/actions": {
      "get": {
        "operationId": "actions",
        "summary": "Get data-driven FinOps action recommendations",
        "description": "Closes the analytics feedback loop: turns the ml.*_output tables into concrete, reviewable actions (model switching, APIM rate/token-limit changes, quota reallocation, throttle guardrails, prompt trimming, chargeback).",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [1, 7, 30, 90],
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recommended action plans derived from the ML output tables.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionRecommendations"
                }
              }
            }
          }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    },
    "/showcase/visits": {
      "post": {
        "operationId": "record-showcase-visit",
        "summary": "Record a public showcase page visit",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "timezone": { "type": "string", "nullable": true, "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Visit recorded in Cosmos DB." }
        }
      },
      "get": {
        "operationId": "get-showcase-visits",
        "summary": "Get the authenticated showcase visits report",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 90, "default": 30 }
          }
        ],
        "responses": {
          "200": { "description": "Showcase visit totals and visit records." }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    },
    "/powerbi/embed": {
      "get": {
        "operationId": "get-powerbi-embed",
        "summary": "Get the Power BI embed configuration",
        "responses": {
          "200": {
            "description": "Configured Power BI reports and dashboards."
          }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    },
    "/pricing": {
      "get": {
        "operationId": "get-model-pricing",
        "summary": "Get the current multi-cloud model pricing catalog",
        "responses": {
          "200": {
            "description": "Current governed model rate cards."
          }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    },
    "/prompts": {
      "get": {
        "operationId": "get-saved-prompts",
        "summary": "Get the pre-saved Data Agent prompt catalog",
        "responses": {
          "200": {
            "description": "Configured prompt catalog, including business ontology prompts."
          }
        },
        "security": [
          { "bearerAuth": [] }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TokenomicsRow": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "TimeBucket": { "type": "string" },
          "ApplicationId": { "type": "string" },
          "Model": { "type": "string" },
          "Requests": { "type": "integer" },
          "TotalTokens": { "type": "integer" },
          "MarketCost": { "type": "number", "nullable": true, "description": "Market rate-card estimate." },
          "NegotiatedCost": { "type": "number", "nullable": true, "description": "Negotiated rate-card estimate." },
          "ActualCost": { "type": "number", "nullable": true, "description": "Azure-billed dedicated model cost allocated by observed token share." }
        }
      },
      "ActualCostSnapshot": {
        "type": "object",
        "required": ["source", "queryType", "status", "scope", "currency", "generatedAt", "expectedBillingLagHours", "allocationMethod"],
        "properties": {
          "source": { "type": "string", "enum": ["AzureCostManagement"] },
          "queryType": { "type": "string", "enum": ["ActualCost"] },
          "status": { "type": "string", "enum": ["available", "empty", "unavailable", "disabled"] },
          "scope": { "type": "string" },
          "currency": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "billedThrough": { "type": "string", "format": "date", "nullable": true },
          "expectedBillingLagHours": { "type": "integer" },
          "scopeCost": { "type": "number", "nullable": true },
          "trackedCost": { "type": "number", "nullable": true },
          "dedicatedModelCost": { "type": "number", "nullable": true },
          "sharedPlatformCost": { "type": "number", "nullable": true },
          "untrackedCost": { "type": "number", "nullable": true },
          "allocatedModelCost": { "type": "number", "nullable": true },
          "allocationMethod": { "type": "string", "enum": ["observed-token-share", "none"] },
          "byService": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "byResource": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "trend": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "TokenomicsDashboard": {
        "type": "object",
        "required": ["generatedAt", "windowDays", "currency", "queryStatus", "actualCost", "summary", "trend", "allocations", "models", "operations", "recentRequests", "dataQuality"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "windowDays": { "type": "integer", "enum": [1, 7, 30, 90] },
          "currency": { "type": "string" },
          "queryStatus": { "type": "string", "enum": ["complete", "partial"] },
          "actualCost": { "$ref": "#/components/schemas/ActualCostSnapshot" },
          "summary": { "type": "object", "additionalProperties": true },
          "trend": { "type": "array", "items": { "$ref": "#/components/schemas/TokenomicsRow" } },
          "allocations": { "type": "array", "items": { "$ref": "#/components/schemas/TokenomicsRow" } },
          "models": { "type": "array", "items": { "$ref": "#/components/schemas/TokenomicsRow" } },
          "operations": { "type": "array", "items": { "$ref": "#/components/schemas/TokenomicsRow" } },
          "recentRequests": { "type": "array", "items": { "$ref": "#/components/schemas/TokenomicsRow" } },
          "dataQuality": { "type": "object", "additionalProperties": true }
        }
      },
      "ActionRecommendations": {
        "type": "object",
        "required": ["generatedAt", "windowDays", "currency", "status", "plans", "categories"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "windowDays": { "type": "integer", "enum": [1, 7, 30, 90] },
          "currency": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "empty", "unavailable"] },
          "detail": { "type": "string" },
          "totalEstimatedAnnualSavingsUsd": { "type": "number" },
          "totalEstimatedMonthlySavingsUsd": { "type": "number" },
          "categories": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "plans": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}